			</dependency>
			<dependency>
				<groupId>io.grpc</groupId>
				<artifactId>grpc-protobuf</artifactId>
				<version>${grpc.version}</version>
			</dependency>
			<!-- Requested at two versions; pin the highest so dependencyConvergence is satisfied. -->
